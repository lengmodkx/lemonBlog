# 阿里云OSS配置
# 请复制此文件为 .env.local 并填入实际配置

# OSS区域
OSS_REGION=oss-cn-beijing

# OSS访问密钥
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# OSS Bucket名称
OSS_BUCKET=

# OSS存储路径前缀
OSS_PREFIX=blog/images/

# RustFS 配置（旅行照片上传，scripts/upload-to-rustfs.js）
# endpoint 为 RustFS 的 S3 兼容地址，不带 bucket 名
RUSTFS_ENDPOINT=http://127.0.0.1:9000
RUSTFS_BUCKET=
RUSTFS_ACCESS_KEY_ID=
RUSTFS_SECRET_ACCESS_KEY=
# 对象路径前缀（可选）
RUSTFS_PREFIX=blog/
# 对外访问地址（可选，CDN/反代域名；缺省为 {endpoint}/{bucket}）
# 仅用于上传脚本打印图片 URL；图片域名白名单请写在 next.config.ts 的 PUBLIC_IMAGE_HOSTS
RUSTFS_PUBLIC_URL=

# Giscus 评论配置
# 获取方式：访问 https://giscus.app 配置你的仓库
NEXT_PUBLIC_GISCUS_REPO=your-username/your-repo
NEXT_PUBLIC_GISCUS_REPO_ID=your_repo_id
NEXT_PUBLIC_GISCUS_CATEGORY=Announcements
NEXT_PUBLIC_GISCUS_CATEGORY_ID=your_category_id
